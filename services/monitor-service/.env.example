# ============================================================
# Minegrid Monitor Service — Environment Variables
# Copier vers .env et renseigner les valeurs
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/monitor_db
# Production (~centaines d’utilisateurs concurrents) : augmenter (ex. 20 / 40)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Supabase (pour vérification JWT des utilisateurs) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Admin ---
# PRODUCTION : token long aléatoire (≥ 32 car.). Ne jamais utiliser la valeur d'exemple.
# Ne jamais copier dans VITE_MONITOR_ADMIN_TOKEN (front) sauf outil interne contrôlé.
ADMIN_TOKEN=

# --- CORS : domaines AUTORISÉS à appeler l'API (séparés par des virgules) ---
# DEV : localhost est déjà autorisé automatiquement.
# PRODUCTION : OBLIGATOIRE — mettre le(s) domaine(s) du front (sinon le navigateur bloque
# les appels). Exemple : ALLOWED_ORIGINS=https://www.minegrid.ma,https://minegrid.ma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- Mascus / Piloterr ---
PILOTERR_API_KEY=

# --- Geocoder (none | photon | self_hosted_nominatim | mapbox) ---
GEOCODER_MODE=none
MAPBOX_TOKEN=
NOMINATIM_URL=http://localhost:8080

# --- LLM Enrichment (none | openai | mock) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Widgets IA (/ai/widgets/*) — charge & coût LLM ---
AI_WIDGET_MAX_PER_MINUTE=120
PAYLOAD_CACHE_TTL_SEC=45

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Production HTTPS (docker-compose.prod.yml + Caddy) ---
# Sous-domaine qui pointe (enregistrement DNS A) vers l'IP de ton VPS.
MONITOR_DOMAIN=monitor.votre-domaine.ma
# Email pour le certificat Let's Encrypt (renouvellement automatique).
ACME_EMAIL=vous@votre-domaine.ma
# Mot de passe Postgres FORT en production (Postgres n'est pas exposé, mais on durcit).
POSTGRES_PASSWORD=

# --- Scheduler frequencies (hours) ---
INGEST_INTERVAL_HOURS=3
ENRICH_INTERVAL_HOURS=12
ALERTS_INTERVAL_HOURS=6
MASCUS_INTERVAL_HOURS=12
