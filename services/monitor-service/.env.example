# ============================================================
# Minegrid Monitor Service — Environment Variables
# Copier vers .env et renseigner les valeurs
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/monitor_db
# Production (~centaines d’utilisateurs concurrents) : augmenter (ex. 20 / 40)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Supabase (pour vérification JWT des utilisateurs) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Admin ---
# PRODUCTION : token long aléatoire (≥ 32 car.). Ne jamais utiliser la valeur d'exemple.
# Ne jamais copier dans VITE_MONITOR_ADMIN_TOKEN (front) sauf outil interne contrôlé.
ADMIN_TOKEN=

# --- Mascus / Piloterr ---
PILOTERR_API_KEY=

# --- Geocoder (none | photon | self_hosted_nominatim | mapbox) ---
GEOCODER_MODE=none
MAPBOX_TOKEN=
NOMINATIM_URL=http://localhost:8080

# --- LLM Enrichment (none | openai | mock) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Widgets IA (/ai/widgets/*) — charge & coût LLM ---
AI_WIDGET_MAX_PER_MINUTE=120
PAYLOAD_CACHE_TTL_SEC=45

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Scheduler frequencies (hours) ---
INGEST_INTERVAL_HOURS=3
ENRICH_INTERVAL_HOURS=12
ALERTS_INTERVAL_HOURS=6
MASCUS_INTERVAL_HOURS=12
