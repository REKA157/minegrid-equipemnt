# =============================================================================
# Minegrid Africa — variables FRONT (Vite)
# Copier vers .env.local pour le dev. Ne jamais committer .env / .env.local.
# Checklist prod : docs/SECURITY_DEPLOY_CHECKLIST.md (Ticket #5)
# =============================================================================

# --- Supabase (obligatoire) — clé ANON uniquement ; jamais service_role ici ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- URL canonique production ---
VITE_PRODUCTION_URL=https://minegrid-equipement.com

# --- Stripe — publishable key UNIQUEMENT (pk_test_… dev / pk_live_… prod) ---
# Secret sk_… → Supabase Edge secret STRIPE_SECRET_KEY uniquement
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Global Monitor API ---
VITE_MONITOR_API_URL=http://localhost:8000
# PROD : laisser VIDE sauf outil admin interne (exposé dans le bundle JS si défini)
VITE_MONITOR_ADMIN_TOKEN=

# --- BYPASS / PROMO — PRODUCTION PUBLIQUE : laisser VIDES ---
# VITE_MONITOR_TEMP_ACCESS_CODE : bypass #global-monitor, #leads, #dossiers, démo login
# VITE_PROMO_CODE : validation promo 100 % client (Dashboard, ProSubscription, PaymentPage)
VITE_MONITOR_TEMP_ACCESS_CODE=
VITE_PROMO_CODE=

# --- Contact (doit matcher CONTACT_RECEIVER_EMAIL côté Edge Function) ---
VITE_CONTACT_RECEIVER_EMAIL=contact@minegrid-equipment.com

# --- n8n Webhooks (optionnel) ---
VITE_N8N_IMPORT_PARC_URL=
VITE_N8N_SCRAPE_PDF_URL=
VITE_N8N_ASSISTANT_URL=
VITE_N8N_AUTO_SPECS_URL=

# --- WhatsApp widget (indicatif + numéro, chiffres seuls, sans +) ---
VITE_WHATSAPP_NUMBER=

# --- Google Maps (optionnel — LocationPicker) ; restreindre la clé par domaine ---
# VITE_GOOGLE_MAPS_API_KEY=

# =============================================================================
# SECRETS SERVEUR — NE PAS mettre dans le front (Supabase Dashboard / monitor .env)
# =============================================================================
# ALLOWED_ORIGINS=https://minegrid-equipement.com,http://localhost:5173
# CONTACT_RECEIVER_EMAIL=contact@minegrid-equipement.com
# CONTACT_SENDER_EMAIL=contact@minegrid-equipement.com
# RESEND_API_KEY=re_xxx
# STRIPE_SECRET_KEY=sk_xxx
# SUPABASE_SERVICE_ROLE_KEY=…  (Edge Functions + monitor-service uniquement)
# SUPABASE_JWT_SECRET=…        (monitor-service uniquement)
# ADMIN_TOKEN=…                (monitor-service uniquement — fort, ≠ changeme)
