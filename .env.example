# =============================================================================
# Minegrid Africa — variables FRONT (Vite)
# Copier vers .env.local pour le dev. Ne jamais committer .env / .env.local.
# Checklist prod : docs/SECURITY_DEPLOY_CHECKLIST.md (Ticket #5)
# =============================================================================

# --- Supabase (obligatoire) — clé ANON uniquement ; jamais service_role ici ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- URL canonique production ---
VITE_PRODUCTION_URL=https://minegrid-equipement.com

# --- Paddle (Merchant of Record) — identifiants PUBLICS uniquement ---
# Client token : Paddle → Developer tools → Authentication → Client-side tokens
# (test_… en sandbox, live_… en prod). Les pri_… sont les prix du catalogue.
# ⚠️ Mapping (cf. src/config/plans.ts) : PREMIUM_20USD → code interne 'pro',
# PRO_50USD → code interne 'premium', ENTERPRISE_200USD → 'enterprise'.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxx
VITE_PADDLE_PRICE_PREMIUM_20USD=pri_xxx
VITE_PADDLE_PRICE_PRO_50USD=pri_xxx
VITE_PADDLE_PRICE_ENTERPRISE_200USD=pri_xxx

# --- Global Monitor API ---
VITE_MONITOR_API_URL=http://localhost:8000
# PROD : laisser VIDE sauf outil admin interne (exposé dans le bundle JS si défini)
VITE_MONITOR_ADMIN_TOKEN=

# --- BYPASS / PROMO — PRODUCTION PUBLIQUE : laisser VIDES ---
# VITE_MONITOR_TEMP_ACCESS_CODE : bypass #global-monitor, #leads, #dossiers, démo login
# VITE_PROMO_CODE : validation promo 100 % client (Dashboard, ProSubscription, PaymentPage)
VITE_MONITOR_TEMP_ACCESS_CODE=
VITE_PROMO_CODE=

# --- Contact (doit matcher CONTACT_RECEIVER_EMAIL côté Edge Function) ---
VITE_CONTACT_RECEIVER_EMAIL=contact@minegrid-equipment.com

# --- n8n Webhooks (optionnel) ---
VITE_N8N_IMPORT_PARC_URL=
VITE_N8N_SCRAPE_PDF_URL=
VITE_N8N_ASSISTANT_URL=
VITE_N8N_AUTO_SPECS_URL=

# --- WhatsApp widget (indicatif + numéro, chiffres seuls, sans +) ---
VITE_WHATSAPP_NUMBER=

# --- Google Maps (optionnel — LocationPicker) ; restreindre la clé par domaine ---
# VITE_GOOGLE_MAPS_API_KEY=

# =============================================================================
# SECRETS SERVEUR — NE PAS mettre dans le front (Supabase Dashboard / monitor .env)
# =============================================================================
# ALLOWED_ORIGINS=https://minegrid-equipement.com,http://localhost:5173
# CONTACT_RECEIVER_EMAIL=contact@minegrid-equipement.com
# CONTACT_SENDER_EMAIL=contact@minegrid-equipement.com
# RESEND_API_KEY=re_xxx
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx  (Edge Function paddle-webhook uniquement)
# PADDLE_PRICE_PREMIUM_20USD / PADDLE_PRICE_PRO_50USD / PADDLE_PRICE_ENTERPRISE_200USD
#   (mêmes pri_… que le front — réconciliation prix↔plan du webhook)
# SUPABASE_SERVICE_ROLE_KEY=…  (Edge Functions + monitor-service uniquement)
# SUPABASE_JWT_SECRET=…        (monitor-service uniquement)
# ADMIN_TOKEN=…                (monitor-service uniquement — fort, ≠ changeme)

# =====================================================================
# Module Appels d'offres — REGLAGES OBLIGATOIRES EN PRODUCTION
# =====================================================================
# Leur ABSENCE ne produit aucune erreur : le module tourne simplement en
# demonstration, ce qui est indetectable sans aller lire le code. Constate
# le 2026-08-18, apres des semaines en ligne dans cet etat.
#
# Sans VITE_TENDERS_AI_URL : l'IA repond « aucun endpoint configure » et TOUT
# est simule — deployer la fonction n'y change rien.
VITE_TENDERS_AI_URL=supabase
# Nom de l'Edge Function IA. Doit correspondre a une fonction REELLEMENT
# deployee (verifier : POST .../functions/v1/<nom> ne doit pas renvoyer 404).
VITE_TENDERS_AI_FUNCTION=tenders-ai
# Sans VITE_TENDERS_SHARED : dossiers en localStorage, aucun partage d'equipe,
# tout perdu au changement de poste. EXIGE la migration teamE (tender_workspaces)
# dans la base visee, sinon banniere d'erreur de synchronisation.
VITE_TENDERS_SHARED=true
