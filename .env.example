# Supabase (obligatoire)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL de production
VITE_PRODUCTION_URL=https://minegrid-equipement.com

# Stripe (paiements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Global Monitor API
VITE_MONITOR_API_URL=http://localhost:8000
VITE_MONITOR_ADMIN_TOKEN=
# Optionnel: laisser vide en production pour désactiver le bypass temporaire.
VITE_MONITOR_TEMP_ACCESS_CODE=
# Optionnel: code promo temporaire (laisser vide pour désactiver complètement).
VITE_PROMO_CODE=
# Optionnel: destinataire de contact/devis côté front (doit matcher CONTACT_RECEIVER_EMAIL côté Edge).
VITE_CONTACT_RECEIVER_EMAIL=contact@minegrid-equipment.com

# n8n Webhooks (automatisations)
VITE_N8N_IMPORT_PARC_URL=
VITE_N8N_SCRAPE_PDF_URL=
VITE_N8N_ASSISTANT_URL=
VITE_N8N_AUTO_SPECS_URL=

# WhatsApp (bouton dans le widget chat) — indicatif pays + numéro, chiffres seuls, sans +
# Exemple Maroc : 212612345678
VITE_WHATSAPP_NUMBER=

# Analytics : charger le script Plausible sur index.html puis window.plausible sera utilisé par src/utils/analytics.ts
# (aucune clé VITE requise pour Plausible self-hosted si le script définit plausible)

# -----------------------------------------------------------------------
# Variables Edge Functions (à définir côté Supabase, pas dans le front)
# -----------------------------------------------------------------------
# ALLOWED_ORIGINS=https://minegrid-equipement.com,http://localhost:5173
# CONTACT_RECEIVER_EMAIL=contact@minegrid-equipement.com
# CONTACT_SENDER_EMAIL=contact@minegrid-equipement.com
# RESEND_API_KEY=re_xxx
