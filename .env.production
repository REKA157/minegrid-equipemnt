# =====================================================================
# Overrides PRODUCTION — chargés UNIQUEMENT par `npm run build` (vite build).
# Ton `.env` de dev n'est pas touché ; il continue de pointer localhost.
# =====================================================================

# Le Global Monitor en ligne (VPS + HTTPS).
VITE_MONITOR_API_URL=https://monitor.minegrid-equipement.com

# SÉCURITÉ : le token admin ne doit JAMAIS être dans le bundle public.
# Le site lit /projects avec le JWT Supabase de l'utilisateur — pas besoin du token.
VITE_MONITOR_ADMIN_TOKEN=

# Code d'accès temporaire / bypass : vide en prod (aucun contournement public).
VITE_MONITOR_TEMP_ACCESS_CODE=
