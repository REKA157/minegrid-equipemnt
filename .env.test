# Variables FACTICES pour la suite de tests du clone NextGen.
# Le clone ne contient AUCUN secret réel (les .env de l'original sont exclus).
# Ces valeurs ne sont pas des secrets : elles servent uniquement à satisfaire le
# garde-fou de src/utils/supabaseClient.ts pendant les tests (mocks Supabase).
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key-not-a-secret
