# =====================================================================
# MODÈLE de configuration STAGING — copie ce fichier en « .env.staging »
# (non versionné) et remplis les valeurs du projet Supabase STAGING + Stripe TEST.
# Lancement : npm run dev -- --mode staging
# NE COMMITE JAMAIS le vrai .env.staging (il contient des clés).
# =====================================================================

# --- Supabase STAGING (Dashboard staging → Settings → API) ---
VITE_SUPABASE_URL=https://TON_REF_STAGING.supabase.co
VITE_SUPABASE_ANON_KEY=colle_ici_l_anon_key_du_staging
# URL publique du staging (redirections d'auth) — mets la même URL que ci-dessus en local, ou l'URL déployée.
VITE_PRODUCTION_URL=http://localhost:5173

# --- Stripe en mode TEST (Dashboard Stripe → Developers → API keys → "Test mode") ---
# Clé PUBLIABLE de test uniquement (commence par pk_test_). La clé SECRÈTE (sk_test_) va
# côté serveur dans les secrets des Edge Functions du staging, JAMAIS ici.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Module Appels d'offres ---
# false = données de démonstration locales (pratique pour tester le module isolément).
# true  = mode partagé (charge l'espace société via la base) — comme en prod.
VITE_TENDERS_SHARED=false
# (optionnel) IA appels d'offres si tu veux la tester ; sinon laisse vide → mode simulation.
VITE_TENDERS_AI_URL=
VITE_TENDERS_AI_KEY=

# --- Monitor / Radar d'opportunités (service séparé) ---
# Laisse vide pour désactiver le radar sur le staging, ou pointe vers ton service monitor.
VITE_MONITOR_API_URL=
VITE_MONITOR_ADMIN_TOKEN=
# Code d'accès démo entreprise (facultatif). Laisse vide pour ne pas exposer la page démo.
VITE_MONITOR_TEMP_ACCESS_CODE=

# --- Divers (recopie de la prod ou valeurs de test) ---
VITE_CONTACT_RECEIVER_EMAIL=test@example.com
VITE_WHATSAPP_NUMBER=
# (optionnel) active les écrans nextgen si tu veux les tester.
VITE_ENABLE_NEXTGEN=
